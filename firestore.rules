// The full rules for the Firebase project (Firestore → Rules), covering both Version A and Version B.
// Paste the whole file: Firebase has one set of rules for the project, so leaving A's part out would break Version A.
// Anyone with the link can read and add entries. Nobody can edit or delete them from the websites.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ---------- Version A ----------
    match /answers/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['date', 'hour', 'score'])
        && request.resource.data.score is int && request.resource.data.score >= 1 && request.resource.data.score <= 5
        && request.resource.data.hour is int && request.resource.data.hour >= 0 && request.resource.data.hour <= 23
        && request.resource.data.date is string && request.resource.data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}');
    }
    match /checkins/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['device', 'date'])
        && request.resource.data.device is string && request.resource.data.device.size() == 32
        && request.resource.data.date is string && request.resource.data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}');
    }
    match /devices/{id} {
      allow read: if true;
      allow create: if id.size() == 32 && request.resource.data.keys().hasOnly(['firstSeen']);
    }

    // ---------- Version B: a feeling word and a reason, from fixed lists ----------
    match /b_answers/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['date', 'hour', 'word', 'reason', 'note'])
        && request.resource.data.word in ['Happy', 'Excited', 'Proud', 'Content', 'Focused', 'Calm', 'Distracted', 'Tired', 'Bored', 'Anxious', 'Stressed', 'Disappointed', 'Frustrated', 'Overwhelmed', 'Angry', 'Hopeless']
        && request.resource.data.reason in ['Too much work', 'Too many meetings', 'Technical difficulties', 'Noise in the office', 'Poor tooling', 'Deadline pressure', 'Unclear priorities', 'Waiting on others', 'Personal reasons', 'Something else', 'Other', 'Great teamwork', 'Finished something', 'Learning something new', 'Focus time', 'Good feedback']
        && (!('note' in request.resource.data) || (request.resource.data.reason == 'Other'
          && request.resource.data.note is string && request.resource.data.note.size() > 0 && request.resource.data.note.size() <= 80))
        && request.resource.data.hour is int && request.resource.data.hour >= 0 && request.resource.data.hour <= 23
        && request.resource.data.date is string && request.resource.data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}');
    }
    match /b_checkins/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['device', 'date'])
        && request.resource.data.device is string && request.resource.data.device.size() == 32
        && request.resource.data.date is string && request.resource.data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}');
    }

    // ---------- shared by both versions ----------
    match /memes/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['src', 'caption', 'addedAt'])
        && request.resource.data.src is string && request.resource.data.src.size() < 950000
        && (request.resource.data.src.matches('https://.*') || request.resource.data.src.matches('data:image/(png|jpeg|gif|webp);base64,.*'))
        && request.resource.data.caption is string && request.resource.data.caption.size() <= 80
        && request.resource.data.addedAt is string;
    }
    match /events/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['date', 'label'])
        && request.resource.data.date is string && request.resource.data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.label is string && request.resource.data.label.size() > 0 && request.resource.data.label.size() <= 30;
    }
  }
}
